# Airflow dedicated env (do not keep real secrets in git)
AIRFLOW_DB_HOST=postgres
AIRFLOW_DB_PORT=5432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=change_me
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_EMAIL=admin@local
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME

# Optional pipeline integrations
DUCKDB_API_BASE=http://home.orochi.chst.dev:8090
DUCKDB_API_KEY=CHANGE_ME
RELAY_URL=https://relay.orochi.chst.dev/relay
RELAY_KEY=CHANGE_ME

# Trino connection used by DAGs
AIRFLOW_CONN_TRINO_DEFAULT=trino://CHANGE_ME@trino:8080/iceberg
FLARESOLVERR_URL=http://flaresolverr:8191/v1
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-trino==5.7.2 --constraint https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.12.txt
